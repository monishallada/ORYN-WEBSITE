# Local production rehearsal (docker compose --profile rehearsal). NODE_ENV is
# "production" in the images; ORYN_LOCAL_REHEARSAL relaxes only the checks a
# laptop cannot pass (https URL, development database password, plain-HTTP
# local S3) and is honoured only because BETTER_AUTH_URL is localhost.
# Every value here is local-only. BETTER_AUTH_SECRET comes from the shell
# (ORYN_REHEARSAL_AUTH_SECRET) and is never committed.
ORYN_LOCAL_REHEARSAL=true
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_ENABLED=true
DATABASE_URL=postgres://oryn_app:oryn_app_dev_only@db:5432/oryn_rehearsal
ORYN_STORAGE_DRIVER=s3
ORYN_S3_ENDPOINT=http://s3:8333
ORYN_S3_BUCKET=oryn-rehearsal
ORYN_S3_REGION=us-east-1
ORYN_S3_FORCE_PATH_STYLE=true
ORYN_S3_ACCESS_KEY_ID=oryn-rehearsal-access-key
ORYN_S3_SECRET_ACCESS_KEY=oryn-rehearsal-secret-key-local-only
# Public provider etiquette: NWS requires a contact. Unset → NWS stays off.
NWS_USER_AGENT=
OVERPASS_URL=https://overpass-api.de/api/interpreter
LOG_LEVEL=info
