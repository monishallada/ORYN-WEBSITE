# ORYN web service — Next.js standalone server (`node server.js`).
#
#   docker build -f Dockerfile.web -t oryn-web .
#   Railway: service variable RAILWAY_DOCKERFILE_PATH=Dockerfile.web
#
# The final stage is the web image, so no build-target selection is needed.
# NEXT_PUBLIC_* values are compiled into the build (pass them as build args;
# Railway passes service variables to the declared ARGs). No secret is needed
# or read at build time. See docs/DEPLOYMENT.md.

ARG NODE_IMAGE=node:22-bookworm-slim

# ── Dependencies (all, for building) ───────────────────────────
FROM ${NODE_IMAGE} AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# ── Build: Next.js standalone server ───────────────────────────
FROM deps AS build
ARG NEXT_PUBLIC_PLATFORM_ENABLED=true
ARG NEXT_PUBLIC_SITE_URL=
ARG NEXT_PUBLIC_COMMAND_URL=
ARG NEXT_PUBLIC_CONTACT_EMAIL=
ENV NEXT_TELEMETRY_DISABLED=1 \
    ORYN_STANDALONE_BUILD=1 \
    NEXT_PUBLIC_PLATFORM_ENABLED=${NEXT_PUBLIC_PLATFORM_ENABLED} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_PUBLIC_COMMAND_URL=${NEXT_PUBLIC_COMMAND_URL} \
    NEXT_PUBLIC_CONTACT_EMAIL=${NEXT_PUBLIC_CONTACT_EMAIL}
COPY . .
RUN npm run build

# ── Web service (final stage) ──────────────────────────────────
FROM ${NODE_IMAGE} AS web
WORKDIR /app
# Empty → the version falls back to RAILWAY_GIT_COMMIT_SHA at runtime, then "dev".
ARG ORYN_APP_VERSION=
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0 ORYN_SERVICE=web ORYN_APP_VERSION=${ORYN_APP_VERSION}
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
# Read by the readiness check and the startup preflight (pending-migration detection).
COPY --from=build --chown=node:node /app/db/migrations ./db/migrations
USER node
EXPOSE 3000
# Docker's own health check (Railway uses its health-check path setting instead).
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# Exec form: node is PID 1 and receives SIGTERM directly.
CMD ["node", "server.js"]
