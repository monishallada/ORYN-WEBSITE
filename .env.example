# ─────────────────────────────────────────────────────────────
# ORYN website — environment variables
# Copy to .env.local for local development. On Vercel, add these
# under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Canonical public URL (used for metadata, sitemap, Open Graph).
# If unset, Vercel's production URL is used automatically, then localhost.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Contact form delivery (Resend — https://resend.com) ─────
# Without these, the form validates submissions but cannot deliver them:
#   • in development it logs submissions to the server console;
#   • in production it tells the visitor delivery is unavailable.
RESEND_API_KEY=
# Address that receives inquiries.
CONTACT_TO_EMAIL=
# Verified sender in Resend, e.g. "ORYN Website <website@yourdomain.com>".
CONTACT_FROM_EMAIL=

# Optional: public inquiry address shown as a fallback on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: URL of the ORYN Command application once it exists
# (e.g. https://command.yourdomain.com). When set, a "Sign in" link appears.
NEXT_PUBLIC_COMMAND_URL=
